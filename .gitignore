# Geometry library — large external data set (1300 .dat files); not shipped in
# releases (see pyproject sdist.exclude) and deliberately kept out of the repo.
/Smoothed_TEfixed_linear/

/venv/
# Bench run artifacts — regenerable outputs of bench/*.py. The baseline-contract
# data (cold_start_sweep.csv) and the narrative REPORT.md are tracked; the
# intermediate sweep/rescue/timing CSV/log/JSON dumps are not.
/bench/results/*.csv
/bench/results/*.log
/bench/results/*.json
!/bench/results/cold_start_sweep.csv

# Guard the repo ROOT against future bench-run litter (root scope only — the
# canonical copies live under bench/results/). Quarantine convention for any
# tracked stray: git mv to _quarantine/ with RESTORE.md (never rm).
/cold_start_sweep.csv
/cold_baseline_orig.csv
/cold_sweep_*.csv
/cold_sweep_*.log
/rescue_*.csv
/rescue_*.log
/tape_reset_*.json
/REPORT.md

# Python
__pycache__/
*.pyc

# Editor
.vscode/
.idea/
*.swp
*~

# Packaging output (python -m build)
/dist/
