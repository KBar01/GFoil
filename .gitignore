# Bench run artifacts — regenerable outputs of bench/*.py. The baseline-contract
# data (cold_start_sweep.csv) and the narrative REPORT.md are tracked; the
# intermediate sweep/rescue/timing CSV/log/JSON dumps are not.
/bench/results/*.csv
/bench/results/*.log
/bench/results/*.json
!/bench/results/cold_start_sweep.csv

